output_path = Path(sys.argv[3])

with open(colors_path, "rb") as f:
    colors = tomllib.load(f)

name = "Omarchy"
if theme_name_path.exists():
    raw = theme_name_path.read_text().strip()
    if raw:
        name = raw.replace("-", " ").replace("_", " ").title()

def hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def rgba(h, a=1.0):
    r, g, b = hex_to_rgb(h)
    return f"rgba({r}, {g}, {b}, {a})"

bg0 = colors.get("darker_background", colors.get("black", "#000000"))
bg1 = colors.get("dark_background", colors.get("background", "#000000"))
bg2 = colors.get("background", "#1b1b1b")
bg3 = colors.get("lighter_background", colors.get("selection", "#333333"))
fg0 = colors.get("bright_foreground", colors.get("white", "#ffffff"))
fg1 = colors.get("foreground", "#ebebeb")
fg2 = colors.get("dark_foreground", "#aaaaaa")
fg3 = colors.get("muted", "#666666")
accent = colors.get("accent", "#3b82f6")
red = colors.get("red", "#ff5555")
green = colors.get("green", "#50fa7b")
